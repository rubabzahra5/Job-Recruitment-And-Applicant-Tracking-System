# ─── Job Recruitment And Applicant Tracking System — ready to run ────
# This file is pre-filled for your Supabase project. It is git-ignored,
# so it will never be committed to GitHub.
#
# ONE step left: paste your service_role key below (Supabase dashboard →
# Settings → API → "service_role" secret key → Reveal → copy).

# Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_URL=https://hjqeadhkzshpuotvxnbh.supabase.co

# Supabase publishable key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_84bEQFDkrNvF9wOsJ33vGA_i3p9j3q_

# Supabase service_role key — SERVER ONLY. Never share, never commit.
# TODO: paste your key here (no spaces around the = sign)
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_KEY_HERE

# Public base URL of the app (used for email links, redirects).
# For local testing keep as below. After Vercel deploy, change to your
# https://your-app.vercel.app address (and set the same in Vercel env vars).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# One-time bootstrap: this email becomes the first Super Admin.
# Run:  BOOTSTRAP_ADMIN_EMAIL=liviamaria752@gmail.com npm run bootstrap-admin
# (type the email again when asked to confirm), then disable this script.
BOOTSTRAP_ADMIN_EMAIL=liviamaria752@gmail.com

# ─── Email (optional) ─────────────────────────────────────────────────
# Leave unset unless you configure Resend. The app uses in-app
# notifications and says so honestly when email is unconfigured.
EMAIL_FROM_ADDRESS=
RESEND_API_KEY=

# ─── Dev seed data (optional) ─────────────────────────────────────────
# scripts/seed.ts refuses to run unless this is exactly "yes".
# It loads clearly-labeled FICTIONAL demo jobs — never run on production.
SEED_CONFIRM=no
